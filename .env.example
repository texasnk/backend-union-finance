# Copy to .env and adjust credentials
# PostgreSQL connection string (Prisma v7 via driver adapter)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/union_finance?schema=public"

# App
PORT=3000
NODE_ENV=development

# Optional AI configuration
# When OPENAI_API_KEY is empty, the app uses the local heuristic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=4000
AI_THRESHOLD=0.8
AI_CACHE_TTL_MINUTES=15
