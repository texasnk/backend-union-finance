{
  "name": "union-finance-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d db adminer",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:ps": "docker compose ps",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "mmd:svg": "for f in docs/*.mmd; do npx mmdc -i \"$f\" -o \"${f%.mmd}.svg\"; done",
    "mmd:png": "for f in docs/*.mmd; do npx mmdc -i \"$f\" -o \"${f%.mmd}.png\"; done"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jest": "^30.3.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.39",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
