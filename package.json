{
  "name": "union-finance-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "mmd:svg": "for f in docs/*.mmd; do npx mmdc -i \"$f\" -o \"${f%.mmd}.svg\"; done",
    "mmd:png": "for f in docs/*.mmd; do npx mmdc -i \"$f\" -o \"${f%.mmd}.png\"; done"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
